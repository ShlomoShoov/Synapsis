# Copy to .env (never commit .env). Docker Compose reads it for ${...} values.

# Where every feeder sends its data. One variable for all of them:
#   http://api-dev:8080                 the Python stand-in API in Compose (profile "dev", the default)
#   http://api:8080                     the C# API once it joins Compose (profile "app")
#   http://host.docker.internal:5080    an API running on your machine (for example from your IDE)
SYNAPSIS_API_URL=http://api-dev:8080
SYNAPSIS_API_KEY=

# Who runs the feeders: a URL or mailbox. Wikimedia and other public APIs refuse anonymous clients.
FEEDER_CONTACT=

# Source credentials (only the feeders that need them receive them)
FIRMS_MAP_KEY=
GFW_TOKEN=
FRED_API_KEY=
NVD_API_KEY=
# Optional: your own copy of the GTD file from START (default: the mirror round 2 used, checked by SHA-256)
GTD_URL=

# Store passwords for development
NEO4J_PASSWORD=synapsis-dev-password
MINIO_ROOT_USER=synapsis
MINIO_ROOT_PASSWORD=synapsis-dev-password
