<Project Sdk="Microsoft.NET.Sdk">
  <!-- Synapsis.Data: the connections to MongoDB and Elasticsearch, the stored shapes, the record classes and their reader. It depends on no other
       Synapsis project, so every service that needs the data (the API now, the consumers and the engine later) can use it. -->
  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="3.12.0" />
    <PackageReference Include="Elastic.Clients.Elasticsearch" Version="8.15.10" />
    <PackageReference Include="Confluent.Kafka" Version="2.6.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.31" />
    <!-- Reads the settings sections (Mongo, Elastic) into their classes. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
  </ItemGroup>
</Project>
