{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapsis.local/schemas/sil-1.2.schema.json",
  "title": "SIL 1.2 ingest bundle",
  "description": "The fixed record envelope. Vocabulary (types, roles, measures, spaces, attributes, sources) is checked against the registry, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sil",
    "batch_id",
    "producer",
    "records"
  ],
  "properties": {
    "sil": {
      "const": "1.2"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{3,120}$"
    },
    "producer": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "package": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}$"
    },
    "package_version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "$ref": "#/$defs/instant"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "recordId": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^(ent|evt|rel|con):[a-z0-9][a-z0-9.-]{0,40}:[A-Za-z0-9][A-Za-z0-9._:/@+~-]{0,240}$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^src:[a-z0-9][a-z0-9.-]*:[a-z0-9][a-z0-9._-]*$"
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "envelope": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "type",
        "source",
        "reliability",
        "reliability_basis",
        "known_at",
        "known_at_basis"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/recordId"
        },
        "type": {
          "$ref": "#/$defs/code"
        },
        "source": {
          "$ref": "#/$defs/sourceId"
        },
        "reliability": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "reliability_basis": {
          "type": "string",
          "maxLength": 20
        },
        "known_at": {
          "$ref": "#/$defs/instant"
        },
        "known_at_basis": {
          "type": "string",
          "maxLength": 40
        },
        "attributes": {
          "type": "object",
          "maxProperties": 60
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "supersedes": {
          "$ref": "#/$defs/recordId"
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "lang": {
          "type": "string",
          "pattern": "^[a-z]{2,3}$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 2000
        },
        "ref": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "precision"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/instant"
        },
        "end": {
          "$ref": "#/$defs/instant"
        },
        "precision": {
          "type": "string"
        }
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "point": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2
        },
        "uncertainty_km": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20000
        },
        "admin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "country"
          ],
          "properties": {
            "country": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "subdivision": {
              "type": "string",
              "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"
            },
            "name": {
              "type": "string",
              "maxLength": 300
            }
          }
        },
        "logical": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "space",
            "path"
          ],
          "properties": {
            "space": {
              "type": "string",
              "maxLength": 80
            },
            "path": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^/]+$"
              }
            }
          }
        },
        "unplaced": {
          "const": true
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity",
        "role"
      ],
      "properties": {
        "entity": {
          "$ref": "#/$defs/recordId"
        },
        "role": {
          "type": "string",
          "maxLength": 60
        }
      }
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "unit"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 60
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "maxLength": 30
        }
      }
    },
    "entity": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "kind": {
          "const": "entity"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "aliases": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "place": {
          "$ref": "#/$defs/place"
        }
      }
    },
    "event": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "time",
        "place"
      ],
      "properties": {
        "kind": {
          "const": "event"
        },
        "time": {
          "$ref": "#/$defs/time"
        },
        "place": {
          "$ref": "#/$defs/place"
        },
        "participants": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/participant"
          }
        },
        "measures": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "$ref": "#/$defs/measure"
          }
        }
      }
    },
    "relation": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "kind": {
          "const": "relation"
        },
        "from": {
          "$ref": "#/$defs/recordId"
        },
        "to": {
          "$ref": "#/$defs/recordId"
        },
        "time": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "conclusion": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "about",
        "statement",
        "premises",
        "method",
        "confidence"
      ],
      "properties": {
        "kind": {
          "const": "conclusion"
        },
        "about": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/recordId"
              },
              {
                "$ref": "#/$defs/subjectKey"
              }
            ]
          }
        },
        "statement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "predicate"
          ],
          "properties": {
            "predicate": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,80}$"
            },
            "object": {
              "type": "string",
              "maxLength": 500
            },
            "value": {}
          }
        },
        "premises": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/recordId"
          }
        },
        "method": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "by",
            "name",
            "version"
          ],
          "properties": {
            "by": {
              "type": "string"
            },
            "name": {
              "type": "string",
              "maxLength": 200
            },
            "version": {
              "type": "string",
              "maxLength": 60
            }
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "subjectKey": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^subject:(h3:[0-9a-f]{15}|logical:[a-z][a-z0-9_.]*/[^\\s]+|admin:[A-Z]{2}(-[A-Z0-9]{1,3})?)$"
    }
  }
}