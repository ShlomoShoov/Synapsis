# Synapsis feeders settings (demo only). Copy to deploy/feeders/.env (never committed) and fill in.

# Where the feeders send their data. http://api:8080 is the core's API inside Docker.
# For an API running on your own machine (for example from your IDE): http://host.docker.internal:<port>
FEEDERS_API_URL=http://api:8080

# A URL or e-mail address for the User-Agent header. Wikipedia and other public APIs ask for one.
FEEDERS_CONTACT=

# ---- Source keys. A feeder whose required key is empty stays up but idle, and its log names the missing key.
# After filling one in: docker compose -f deploy/feeders/compose.yml up -d   (recreates only what changed)

# NASA FIRMS map key. Required by feeder-firms. Free: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FEEDERS_FIRMS_MAP_KEY=

# Global Fishing Watch API token. Required by feeder-gfw. Free: https://globalfishingwatch.org/our-apis/
FEEDERS_GFW_TOKEN=

# FRED API key. Required by feeder-fred. Free: https://fred.stlouisfed.org/docs/api/api_key.html
FEEDERS_FRED_API_KEY=

# NVD API key. Optional for feeder-nvd: it only raises NVD's rate limit. Free: https://nvd.nist.gov/developers/request-an-api-key
FEEDERS_NVD_API_KEY=

# Optional for feeder-gtd: a URL of your own copy of the GTD 1970-1994 file from START. Empty = the public mirror.
FEEDERS_GTD_URL=
