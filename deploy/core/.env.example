# Synapsis core settings. Copy to deploy/core/.env (never committed) and change what you need.

# The key the API requires from every caller ("Authorization: Bearer <key>").
# Empty = the API accepts every caller (fine on one machine). The feeders send FEEDERS_API_KEY: give it the same value.
CORE_API_KEY=

# Elasticsearch memory (Java heap). 1g suits development; lower it only on a machine with little memory.
CORE_ES_HEAP=1g
