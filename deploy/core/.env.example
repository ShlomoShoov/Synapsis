# Synapsis core settings. Copy to deploy/core/.env (never committed) and change what you need.

# Elasticsearch memory (Java heap). 1g suits development; lower it only on a machine with little memory.
CORE_ES_HEAP=1g

# Neo4j Browser and projector credentials. Set a private password in deploy/core/.env.
CORE_NEO4J_USERNAME=neo4j
CORE_NEO4J_PASSWORD=
