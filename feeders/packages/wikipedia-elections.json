      "title": "A statewide presidential poll (last field day)",
      "place": [
        "admin"
      ],
      "roles": {
        "publisher": [
          "Pollster"
        ],
        "about": [
          "Subdivision"
        ]
      },
      "measures": [
        "margin",
        "share_r",
        "share_d"
      ],
      "attributes": {
        "election_year": {
          "type": "integer",
          "min": 1900,
          "max": 2100
        },
        "republican": {
          "type": "string",
          "max_length": 100
        },
        "democrat": {
          "type": "string",
          "max_length": 100
        }
      }
    },
    {
      "code": "POL.ELECTION.RESULT",
      "title": "A state's presidential election result",
      "place": [
        "admin"
      ],
      "roles": {
        "about": [
          "Subdivision"
        ]
      },
      "measures": [
        "margin",
        "share_r",
        "share_d"
      ],
      "attributes": {
        "election_year": {
          "type": "integer",
          "min": 1900,
          "max": 2100
        },
        "republican": {
          "type": "string",
          "max_length": 100
        },
        "democrat": {
          "type": "string",
          "max_length": 100
        }
      }
    }
  ],
  "measures": [
    {
      "name": "margin",
      "title": "Republican minus Democratic share",
      "unit": "points",
      "signed": true,
      "min": -100,
      "max": 100
