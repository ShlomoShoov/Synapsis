{
  "note": "UCDP Georeferenced Event Dataset: organised violence with dates, places, sides and deaths.",
  "package": "ucdp",
  "title": "UCDP Georeferenced Event Dataset (annual and candidate releases)",
  "description": "One event per UCDP violent event: state-based, non-state or one-sided violence, with its place, its sides and its deaths (best estimate, low and high). The annual release (GED) and the monthly candidate releases are two sources: the candidate data is preliminary and later revised in the annual release, so the same UCDP id can carry both.",
  "maintainer": "synapsis-feeders",
  "namespaces": {
    "records": [
      "ucdp"
    ],
    "entities": [
      "ucdp-actor"
    ]
  },
  "sources": [
    {
      "id": "src:ucdp:ged",
      "title": "UCDP Georeferenced Event Dataset, annual release",
      "publisher": "Uppsala Conflict Data Program, Uppsala University",
      "url": "https://ucdp.uu.se/downloads/",
      "license": "CC BY 4.0",
      "reliability": 90,
      "reliability_basis": "B2",
      "publication_lag_days": 28,
      "known_at_rule": "End date of the event plus 28 days, the cadence of UCDP's monthly candidate releases. Annual revisions are dated with the same rule, so a rewind shows the revised figures from that date (basis proxy_publication_lag)."
    },
    {
      "id": "src:ucdp:candidate",
      "title": "UCDP Candidate Events Dataset, monthly releases",
      "publisher": "Uppsala Conflict Data Program, Uppsala University",
      "url": "https://ucdp.uu.se/downloads/#candidate",
      "license": "CC BY 4.0",
      "reliability": 80,
      "reliability_basis": "B3",
      "publication_lag_days": 28,
      "known_at_rule": "End date of the event plus 28 days (basis proxy_publication_lag)."
    }
  ],
  "event_types": [
    {
      "code": "SEC.CONFLICT.STATE_BASED",
      "title": "State-based armed conflict event (a government is one side)",
      "place": [
        "point",
        "admin",
        "unplaced"
      ],
      "roles": {
        "side_a": [
          "ArmedActor"
        ],
        "side_b": [
          "ArmedActor"
        ]
      },
      "measures": [
