{
  "note": "Global Fishing Watch: behaviour of chosen vessels from AIS (loitering and port visits).",
  "package": "gfw",
  "title": "Global Fishing Watch vessel events",
  "description": "Loitering and port-visit events detected by Global Fishing Watch from AIS tracks, for vessels chosen from the OpenSanctions maritime list. By default the feeder reproduces round 3's design: 70 shadow-fleet vessels and 70 vessels with port-state detentions only (random sample, seed 7), events from 2023 to 2025.",
  "maintainer": "synapsis-feeders",
  "namespaces": {
    "records": [
      "gfw"
    ]
  },
  "sources": [
    {
      "id": "src:gfw:events",
      "title": "Global Fishing Watch Events API v3",
      "publisher": "Global Fishing Watch",
      "url": "https://globalfishingwatch.org/our-apis/",
      "license": "CC BY-NC 4.0; API terms of use (token required)",
      "reliability": 80,
      "reliability_basis": "measured",
      "publication_lag_days": 3,
      "known_at_rule": "End of the event plus 3 days, GFW's processing delay (basis proxy_publication_lag)."
    }
  ],
  "event_types": [
    {
      "code": "MAR.VESSEL.LOITERING",
      "title": "A vessel loiters at sea (low speed for hours)",
      "place": [
        "point",
        "admin"
      ],
      "roles": {
        "subject": [
          "Vessel"
        ]
      },
      "measures": [
        "duration_hours",
        "distance_km",
        "average_speed_knots",
        "distance_from_shore_km"
      ],
      "attributes": {
        "gfw_vessel_id": {
          "type": "string",
          "max_length": 100
        },
        "eez": {
          "type": "string_list",
          "max_items": 10,
          "max_length": 20
        }
      }
    },
    {
      "code": "MAR.VESSEL.PORT_VISIT",
      "title": "A vessel visits a port or anchorage",
      "place": [
        "point",
        "admin"
      ],
      "roles": {
        "subject": [
          "Vessel"
        ]
      },
      "measures": [
        "duration_hours"
      ],
      "attributes": {
        "gfw_vessel_id": {
          "type": "string",
          "max_length": 100
        },
        "anchorage": {
          "type": "string",
          "max_length": 300
        },
        "port_flag": {
          "type": "string",
          "max_length": 10
        },
        "confidence": {
          "type": "integer",
          "min": 0,
          "max": 4
        }
      }
    }
  ],
  "measures": [
    {
      "name": "duration_hours",
      "title": "Duration",
      "unit": "hours",
      "min": 0
    },
    {
      "name": "distance_km",
      "title": "Distance travelled",
      "unit": "km",
      "min": 0
    },
    {
      "name": "average_speed_knots",
      "title": "Average speed",
      "unit": "knots",
      "min": 0
    },
    {
      "name": "distance_from_shore_km",
      "title": "Average distance from shore",
      "unit": "km",
      "min": 0
    }
  ]
}
