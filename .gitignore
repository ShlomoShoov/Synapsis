# Secrets: deploy/core/.env and deploy/feeders/.env (copies of their .env.example files). Never commit them.
.env
# CA certificates for networks that inspect TLS (put them in deploy/certs/ before building)
deploy/certs/*.crt
# Feeder state and downloads when a feeder runs outside Docker
.feeder-state/
.feeder-cache/
# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
# .NET
bin/
obj/
# Node
node_modules/
dist/
# Editors
.idea/
.vscode/
# Local documentation and Claude files: kept on each developer's machine, never committed
CLAUDE.md
.claude/
docs/
# UI films: large; re-made from their sources with src/ui/scripts/prepare-film.sh (see src/ui/CLAUDE.md)
src/ui/assets/media/**/*.mp4

# C# tests: kept local, they verify the server (tests/dotnet/Synapsis.Tests.sln)
tests/dotnet/
